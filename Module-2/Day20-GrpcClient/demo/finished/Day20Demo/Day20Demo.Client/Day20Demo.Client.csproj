<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Client-side gRPC packages. Grpc.Net.ClientFactory provides the
         AddGrpcClient<T>() DI extension used in Program.cs (the client analogue
         of Day-19's Grpc.AspNetCore server hosting). Grpc.Tools runs the same
         build-time codegen as Day-19, and Google.Protobuf is the message runtime. -->
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.70.0" />
    <PackageReference Include="Grpc.Tools" Version="2.70.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SAME product.proto as the server, but GrpcServices="Client" flips
         what Grpc.Tools generates: Day-19's server csproj set "Server" to emit the
         ProductCatalogBase to inherit; "Client" emits the typed ProductCatalogClient
         stub to call. One contract, opposite ends of the wire. Link= points the
         build at the server project's copy so there's a single source .proto. -->
    <Protobuf Include="..\Day20Demo.Server\Protos\product.proto" GrpcServices="Client" Link="Protos\product.proto" />
  </ItemGroup>

</Project>
